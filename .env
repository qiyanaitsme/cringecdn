# Backend Environment
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/imagehost?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-key-do-not-use-in-production
JWT_EXPIRES_IN=7d
JWT_EXPIRES_IN_REMEMBER=30d

# Registration
REGISTRATION_ENABLED=false

# File Upload
UPLOAD_MAX_SIZE=20971520
UPLOAD_ALLOWED_FORMATS=jpg,jpeg,png,gif,webp
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Security
BCRYPT_SALT_ROUNDS=10

# Logging
LOG_LEVEL=debug