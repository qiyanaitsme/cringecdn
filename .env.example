# ImageHost Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=5000

# Database
POSTGRES_USER=imagehost
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=imagehost
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-chars-long-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
UPLOAD_PATH=./uploads
UPLOAD_MAX_SIZE=20971520
UPLOAD_ALLOWED_FORMATS=jpg,jpeg,png,gif,webp

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BRUTEFORCE_MAX_ATTEMPTS=5
BRUTEFORCE_WINDOW_MS=900000

# Registration
REGISTRATION_ENABLED=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_NGINX_URL=http://localhost